#include <iostream>
using namespace std;

namespace First {
    int a = 10;

    void display() {
        cout << "This is First namespace." << endl;
        cout << "Value of a = " << a << endl;
    }
}

namespace Second {
    int a = 20;

    void display() {
        cout << "This is Second namespace." << endl;
        cout << "Value of a = " << a << endl;
    }
}

int main() {
    First::display();
    Second::display();

    cout << "First namespace a = " << First::a << endl;
    cout << "Second namespace a = " << Second::a << endl;

    return 0;
}
