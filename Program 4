#include <iostream>
using namespace std;

class Complex{
    int real, img;

public:
    void getdata(){
        cout << "Enter real part: ";
        cin >> real;
        cout << "Enter imaginary part: ";
        cin >> img;
    }

    void multiply(int scalar){
        real=real*scalar;
        img=img*scalar;
    }

    void putdata(){
        if (img >= 0)
            cout << "Result = " << real << " + " << img << "i";
        else
            cout << "Result = " << real << " - " << -img << "i";
    }
};

int main(){
    Complex c;
    int scalar;

    c.getdata();
    cout << "Enter scalar value: ";
    cin >> scalar;

    c.multiply(scalar);
    c.putdata();

    return 0;
}
