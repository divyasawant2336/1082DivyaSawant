#include <iostream>
#include <cstring>
using namespace std;

class String {
    char str[100];

public:
    String() {
        str[0] = '\0';
        cout << "Constructor called" << endl;
    }

    void Accept() {
        cout << "Enter a string: ";
        cin.getline(str, 100);
    }

    void Display() {
        cout << "The string is: " << str << endl;
    }

    ~String() {
        cout << "Destructor called" << endl;
    }
};

int main() {
    String s;

    s.Accept();
    s.Display();

    return 0;
}
